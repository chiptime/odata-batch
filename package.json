{
  "name": "odata-batch",
  "version": "1.3.0",
  "description": "a simple lib for send and recieve calls odata batch ",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "jest",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepublish": "tsc --project tsconfig.json",
    "build": "tsc --project tsconfig.json",
    "_watch": "NODE_DEBUG_PORT=9230 PORT=3000 nodemon --config nodemon.json",
    "watch": "nodemon --config nodemon.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chiptime/odata-batch.git"
  },
  "keywords": [
    "odata",
    "oData",
    "v2",
    "v3",
    "v4",
    "odata2",
    "odata3",
    "odata4",
    "batch",
    "operation",
    "batchcall",
    "sap"
  ],
  "author": "Bruno Ivan Silva Narro",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/chiptime/odata-batch/issues"
  },
  "homepage": "https://github.com/chiptime/odata-batch#readme",
  "devDependencies": {
    "@types/jest": "^27.5.2",
    "@types/node": "^15.12.4",
    "@typescript-eslint/eslint-plugin": "^4.33.0",
    "@typescript-eslint/parser": "^4.33.0",
    "axios-mock-adapter": "^1.22.0",
    "eslint": "^7.32.0",
    "jest": "^27.5.1",
    "nodemon": "^2.0.7",
    "prettier": "^2.8.8",
    "ts-jest": "^27.1.5",
    "typescript": "^4.3.4"
  },
  "dependencies": {
    "axios": "0.21.1"
  },
  "overrides": {
    "@types/babel__traverse": "7.17.1"
  }
}
