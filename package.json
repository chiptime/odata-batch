{
  "name": "odata-batch",
  "version": "2.0.0",
  "description": "Build and parse OData V2 $batch multipart requests: multiple changesets, per-response error detection and typed results",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "jest",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "build": "tsc --project tsconfig.json",
    "_watch": "NODE_DEBUG_PORT=9230 PORT=3000 nodemon --config nodemon.json",
    "watch": "nodemon --config nodemon.json",
    "mutation": "stryker run",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chiptime/odata-batch.git"
  },
  "keywords": [
    "odata",
    "odata-v2",
    "odata2",
    "batch",
    "$batch",
    "multipart",
    "batchcall",
    "sap"
  ],
  "author": "Bruno Ivan Silva Narro",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/chiptime/odata-batch/issues"
  },
  "homepage": "https://github.com/chiptime/odata-batch#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/jest-runner": "^10.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.1",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^10.10.0",
    "jest": "^30.5.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "axios": "^1.20.0"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ]
}
